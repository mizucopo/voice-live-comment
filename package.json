{
  "name": "voice-live-comment",
  "version": "2.1.1",
  "description": "音声認識でYouTube Liveにコメント投稿",
  "private": true,
  "author": "みず",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && rollup -c && node scripts/copy-extension-assets.mjs",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:run && npm run build",
    "clean": "node scripts/clean-dist.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "oxlint --type-aware --deny-warnings .",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@vitest/coverage-v8": "^5.1.0",
    "jsdom": "^31.0.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "^7.0.2006",
    "prettier": "^3.9.10",
    "rollup": "^4.68.0",
    "typescript": "^7.0.2",
    "vitest": "^5.0.0"
  },
  "dependencies": {
    "onnxruntime-web": "^1.31.1"
  }
}
